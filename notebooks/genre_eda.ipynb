   "source": [
    "import pandas as pd\n",
    "df = pd.read_csv('../data/corpus_metadata.csv')\n",
    "df['decade'] = (df['year'] // 10 * 10).astype('Int64')\n",
    "labeled = df[df['genre'].notna() & (df['year'] > 0)]\n",
    "crosstab = pd.crosstab(labeled['genre'], labeled['decade'])\n",
    "print(crosstab)"
   ]
